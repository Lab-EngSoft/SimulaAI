DATABASE_URL=postgresql://usuario:senha@localhost:5432/simulaai
SECRET_KEY=chave-local-apenas-para-desenvolvimento
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ambiente: "production" desativa o seed de dados de demonstração
APP_ENV=development
# IA das explicações (história #7) — provedor NVIDIA NIM, compatível com o SDK da OpenAI.
# Sem chave configurada, a correção objetiva segue funcionando normalmente.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3-flash
# Frontend (integrado à API)
VITE_API_URL=http://localhost:8000
